# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a free API key at https://aistudio.google.com/app/apikey

# Your Google Gemini API key (server-side only - never put this in frontend code)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-2.0-flash)
# If gemini-2.0-flash is unavailable on your key, try: gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.0-flash

# Optional: port (defaults to 3000)
# PORT=3000
